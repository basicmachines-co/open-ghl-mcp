# Authentication Mode Configuration
# Choose between "standard" or "custom"
# The default is standard

# ===== STANDARD MODE CONFIGURATION =====
# This file is unused

# ===== CUSTOM MODE CONFIGURATION =====
# Use these settings if AUTH_MODE=custom
# You'll need to create your own OAuth app in GoHighLevel

AUTH_MODE=custom
# Your GoHighLevel Marketplace App credentials.
# Basic Machines team: copy these from the 1Password vault item
# "GoHighLevel MCP — App Credentials" (do NOT create your own app).
GHL_CLIENT_ID=your-client-id-here
GHL_CLIENT_SECRET=your-client-secret-here

# OAuth callback (defaults are correct; the app already registers
# http://localhost:8080/oauth/callback as a redirect URL)
OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
OAUTH_SERVER_PORT=8080
